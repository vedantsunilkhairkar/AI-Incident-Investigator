# Copy this file to .env and fill in your values
# Never commit .env to git!

# PostgreSQL connection string
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/incident_db

# Google Gemini API key — get one at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# JWT secret key — use a long random string in production
JWT_SECRET_KEY=change_me_to_a_long_random_secret
